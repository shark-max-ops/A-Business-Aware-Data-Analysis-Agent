APP_HOST=127.0.0.1
APP_PORT=8000
STORAGE_DIR=./storage
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-tool-capable-model
EMBEDDING_BASE_URL=https://your-provider.example/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=your-embedding-model
# Wiki 生成使用 JSON 输出；当前实测服务支持 none。其他服务不支持时留空。
WIKI_REASONING_EFFORT=none
# Agent 原生工具调用；不支持 reasoning_effort 的服务可留空。
AGENT_REASONING_EFFORT=none
RUN_CONTEXT_TOKENS=32000
RUN_OUTPUT_TOKENS=3000
RUN_MAX_TURNS=16
RUN_MAX_TOOL_CALLS=24
RUN_TIMEOUT_SECONDS=180
SQL_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=1000
