          "database": {
            "type": "string",
            "enum": [
              "ready",
              "migration_required",
              "unavailable"
            ],
            "title": "Database"
          },
          "fts5": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Fts5"
          },
          "worker": {
            "type": "string",
            "const": "not_implemented",
